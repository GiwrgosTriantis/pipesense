# Production-like: same image, managed-service equivalents. Selected with `--profile prod`.
# The credentials below only exist inside this local compose network. On AWS they are absent:
# the task role supplies credentials and the AWS_ENDPOINT_URL_* overrides are not set.
PIPESENSE_ENV=prod
PIPESENSE_ARTIFACT_ROOT=s3://pipesense/artifacts
MLFLOW_TRACKING_URI=http://mlflow-prod:5000
PIPESENSE_STATUS_BACKEND=file
PIPESENSE_LOG_FORMAT=json
AWS_ENDPOINT_URL_S3=http://s3:8333
AWS_ACCESS_KEY_ID=pipesense
AWS_SECRET_ACCESS_KEY=pipesense-local-secret
AWS_DEFAULT_REGION=us-east-1
